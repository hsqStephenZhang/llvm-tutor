{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MyDomTreePass",
            "type": "lldb",
            "request": "launch",
            "program": "/opt/homebrew/opt/llvm/bin/opt",
            "args": [
                "-load-pass-plugin=${workspaceFolder}/build/lib/libHelloWorld.dylib",
                "-passes=my-domtree",
                "-disable-output",
                "${workspaceFolder}/mytest/domtree/test.ll"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true,
        },
        {
            "name": "Debug ConstPropPass",
            "type": "lldb",
            "request": "launch",
            "program": "/opt/homebrew/opt/llvm/bin/opt",
            "args": [
                "-load-pass-plugin=${workspaceFolder}/build/lib/libConstProp.dylib",
                "-passes=my-constprop",
                "-disable-output",
                "${workspaceFolder}/mytest/constprop/test1.ll"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true,
        }
    ]
}